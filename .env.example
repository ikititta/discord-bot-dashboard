# Discord Developer Portal -> your application
# Bot -> Reset Token
DISCORD_TOKEN=

# DeepSeek API key. AI replies are disabled when this is empty.
DEEPSEEK_API_KEY=

# Optional Mrs. Maid GIF API key for curated anime-violence GIFs in !kill, !slap, !bonk, !spank, and !kick.
# Create a key at https://mrs-maid.cc/gif-api. Without it, Sugar uses the existing anime GIF providers.
MRS_MAID_GIF_KEY=

# Optional OpenAI API key for generating one original image per adopted pet.
# Pet art is stored on the persistent data volume and reused after restarts.
OPENAI_API_KEY=

# OAuth2 -> Client ID
DISCORD_CLIENT_ID=
# OAuth2 -> Client Secret -> Reset Secret
DISCORD_CLIENT_SECRET=

# Any long random string. It signs the dashboard's login cookie.
SESSION_SECRET=

# The public address of the dashboard. FadeHost sets this when the web
# address is on. Locally, set it yourself, e.g. http://localhost:8080
APP_URL=

# The port to listen on. FadeHost sets this for you.
PORT=8080

# Optional path to a host-mounted persistent directory for settings.
DATA_DIR=
